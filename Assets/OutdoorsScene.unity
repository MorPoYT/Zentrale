    audioTrack: 1
    displayDuration: 3
  - speakerName: "\u043A\u0440\u0430\u0441\u043D\u044B\u0439 \u043F\u0440\u044F\u043C\u043E\u0443\u0433\u043E\u043B\u044C\u043D\u0438\u043A"
    dialogueText: "\u041D\u0443 \u0435\u0431\u0430\u0442\u044C \u0442\u044B \u0445\u0430\u043C\u043B\u043E,
