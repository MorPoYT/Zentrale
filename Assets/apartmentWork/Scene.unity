  m_Name: 
  m_EditorClassIdentifier: 
  dialogueSystem: {fileID: 411308835}
  newDialogueLines:
  - speakerName: "\u0418\u0433\u043E\u0440\u044C"
    dialogueText: "\u041A\u0430\u043A\u043E\u0451 \u044D\u0442\u043E \u0447\u0443\u0434\u0435\u0441\u043D\u043E\u0435
      \u0443\u0442\u0440\u043E."
    audioClip: {fileID: 8300000, guid: 3a087af13d1e8ea418b3cd57ebba730a, type: 3}
    audioTrack: 1
    displayDuration: 3
  - speakerName: "\u0418\u0433\u043E\u0440\u044C"
    dialogueText: "\u042F \u043F\u0440\u043E\u0442\u0438\u0440\u0430\u043B \u0433\u043B\u0430\u0437\u0430,
      \u0431\u0443\u0434\u0442\u043E \u0441\u0442\u0438\u0440\u0430\u044F \u0441
      \u043D\u0438\u0445 \u043F\u0435\u043B\u0435\u043D\u0443 \u0438\u043B\u043B\u044E\u0437\u0438\u0439."
    audioClip: {fileID: 8300000, guid: 06704ef2125c74a498207dd49a718617, type: 3}
    audioTrack: 1
    displayDuration: 4
  - speakerName: "\u0418\u0433\u043E\u0440\u044C"
    dialogueText: "\u0441\u043B\u043E\u0432\u043D\u043E \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435:
      \u0437\u0434\u0435\u0441\u044C \u0442\u043E\u0436\u0435 \u0435\u0441\u0442\u044C
      \u043F\u043B\u043E\u0442\u044C, \u0430 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0432\u0437\u0433\u043B\u044F\u0434."
    audioClip: {fileID: 8300000, guid: c8012892512166e4aaa1de1c2d1c25a6, type: 3}
    audioTrack: 1
    displayDuration: 6
  - speakerName: "\u0418\u0433\u043E\u0440\u044C"
    dialogueText: "\u0414\u0430 \u044F \u0441\u043D\u043E\u0432\u0430 \u0437\u0434\u0435\u0441\u044C..."
    audioClip: {fileID: 8300000, guid: 61bb2b67f8dbb7746a5fb78a0b86dc1a, type: 3}
    audioTrack: 1
    displayDuration: 3
  - speakerName: "\u0418\u0433\u043E\u0440\u044C"
    dialogueText: "\u0421\u043D\u043E\u0432\u0430 \u0442\u0443\u0442..."
    audioClip: {fileID: 8300000, guid: 57ae5b6a86abc9c45bdbef1a1b4b3a57, type: 3}
    audioTrack: 1
    displayDuration: 3
  - speakerName: "\u0418\u0433\u043E\u0440\u044C"
    dialogueText: "\u0418 \u0441\u043D\u043E\u0432\u0430 \u044F."
    audioClip: {fileID: 8300000, guid: a566e188efe741543a71bff99e9830d6, type: 3}
    audioTrack: 1
    displayDuration: 3
